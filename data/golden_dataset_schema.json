{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldenDataset",
  "description": "The complete golden evaluation dataset for LLM-CI.",
  "type": "object",
  "required": ["version", "created_at", "cases"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Dataset version"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 creation timestamp"
    },
    "cases": {
      "type": "array",
      "description": "Array of evaluation cases",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "expected_category",
          "expected_summary_keywords",
          "difficulty",
          "tags",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^case_\\d{3}$",
            "description": "Unique case identifier, e.g. case_001"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "Raw email text"
          },
          "expected_category": {
            "type": "string",
            "enum": ["billing", "technical", "account", "general"],
            "description": "Ground truth category"
          },
          "expected_summary_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Keywords a good summary should contain"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard", "edge"],
            "description": "Case difficulty level"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Relevant tags for this case"
          },
          "notes": {
            "type": "string",
            "description": "Why this case exists and what it tests"
          },
          "adversarial_target": {
            "type": ["string", "null"],
            "description": "The category adversarial cases are designed to trigger (null for non-adversarial)"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "description": "Generation metadata for reproducibility",
      "properties": {
        "generator_model": {
          "type": "string",
          "description": "Model used to generate the dataset"
        },
        "prompt_version": {
          "type": "string",
          "description": "Version of the prompt used"
        },
        "temperature": {
          "type": "number",
          "description": "Sampling temperature"
        },
        "generation_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp of generation"
        },
        "total_api_calls": {
          "type": "integer",
          "description": "Number of API calls made"
        },
        "total_input_tokens": {
          "type": "integer",
          "description": "Total input tokens consumed"
        },
        "total_output_tokens": {
          "type": "integer",
          "description": "Total output tokens generated"
        },
        "estimated_cost_aud": {
          "type": "number",
          "description": "Estimated total cost in AUD"
        },
        "generation_mode_counts": {
          "type": "object",
          "description": "Number of cases per generation mode",
          "properties": {
            "standard": { "type": "integer" },
            "adversarial": { "type": "integer" },
            "multilingual": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "generator_model",
        "prompt_version",
        "temperature",
        "generation_timestamp",
        "total_api_calls",
        "total_input_tokens",
        "total_output_tokens",
        "estimated_cost_aud",
        "generation_mode_counts"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
